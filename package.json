{
  "name": "svelte-docinfo",
  "version": "0.8.0",
  "description": "static analysis for TypeScript and Svelte",
  "glyph": "📜",
  "logo": "logo.svg",
  "logo_alt": "a cyan scroll with curling ends",
  "license": "MIT",
  "homepage": "https://svelte-docinfo.fuz.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzdev/svelte-docinfo.git"
  },
  "keywords": [
    "svelte",
    "typescript",
    "documentation",
    "static-analysis",
    "api-docs",
    "component",
    "jsdoc",
    "tsdoc",
    "vite-plugin"
  ],
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "setup-examples": "npm install --prefix examples/api && npm install --prefix examples/vite",
    "preview": "vite preview",
    "deploy": "gro deploy"
  },
  "type": "module",
  "bin": {
    "svelte-docinfo": "dist/main.js"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "commander": "^14.0.3",
    "es-module-lexer": "^2.0.0",
    "picomatch": "^4.0.4",
    "tinyglobby": "^0.2.15"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "svelte2tsx": "^0.7.30",
    "typescript": "^5.9.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.50.0",
    "@fuzdev/fuz_css": "^0.65.2",
    "@fuzdev/fuz_ui": "^0.210.2",
    "@fuzdev/fuz_util": "^0.69.0",
    "@fuzdev/gro": "^0.213.0",
    "@fuzdev/mdz": "^0.3.0",
    "@ryanatkn/eslint-config": "^0.12.2",
    "@sveltejs/acorn-typescript": "^1.0.9",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.4",
    "@types/picomatch": "^4.0.2",
    "@webref/css": "^8.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.19.0",
    "esm-env": "^1.2.2",
    "magic-string": "^0.30.21",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "svelte2tsx": "^0.7.55",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zimmerframe": "^1.1.4",
    "zod": "^4.3.6"
  },
  "sideEffects": [],
  "files": [
    "dist",
    "virtual-svelte-docinfo.d.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./virtual-svelte-docinfo.js": {
      "types": "./virtual-svelte-docinfo.d.ts"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
